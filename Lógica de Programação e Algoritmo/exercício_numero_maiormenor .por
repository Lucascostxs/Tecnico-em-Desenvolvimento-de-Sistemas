programa {
  funcao inicio() {
    inteiro num1, num2
    
    escreva("Digite o primeiro numero: ")
    leia(num1)

    escreva("Digite o segundo numero: ")
    leia(num2)

    se (num1 > num2){
    escreva("num1 e maior que num2")
  }
    senao se(num2 > num1){
    escreva("num2 e maior que num1")
}
    senao se(num1 == num2){
     escreva ("os dois são iguais")
    }
  }
}
